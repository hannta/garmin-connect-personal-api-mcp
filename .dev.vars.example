# Copy to .dev.vars for local development (.dev.vars is git-ignored).
# In production, set each value with: npx wrangler secret put <NAME>

# Garmin Connect Personal API key (Garmin Connect → Personal API Key page)
GARMIN_API_KEY=your-key-here

# Sign-in passphrase for the MCP connector (16+ characters; changing it signs out
# connected apps) — generate with: openssl rand -base64 32
OWNER_PASSPHRASE=
